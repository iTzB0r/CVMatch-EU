# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave publishable (segura para uso no navegador)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secret (somente servidor — NUNCA usar prefixo NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_...

# IA — ThonyGG (API compatível com Anthropic)
THONYGG_API_KEY=sk-thonygg-...
THONYGG_BASE_URL=https://api.thonygg.cloud/v1
# Modelo disponível no painel ThonyGG
THONYGG_MODEL=claude-sonnet-4-6

